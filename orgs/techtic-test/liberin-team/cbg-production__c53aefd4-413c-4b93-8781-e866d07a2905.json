        "getOption": "let inlet = [];\nlet outlet = [];\n\ncontext.panel.data.series.forEach((s) => {\n  //if (s.refId==='Daily Flow FIT 600-01') {\n  timeData = s.fields.find((f) => f.name === \"Time\")?.values ?? [];\n  inlet = s.fields.find((f) => f.name === \"FIQ PSA Inlet\")?.values ?? [];\n  outlet = s.fields.find((f) => f.name === \"FIQ PSA Outlet\")?.values ?? [];\n});\n\nlet totalDailyFlow = [];\nfor (let i = 0; i < timeData.length; i++) {\n  let total = 0;\n  total += inlet[i] || 0;\n  total += outlet[i] || 0;\n  totalDailyFlow.push(total);\n}\n\n\n// Format dates for x-axis with Asia/Kolkata timezone\nconst formattedDates = timeData.map((d) => {\n  const date = new Date(d); // Parse the date string\n\n  // Convert to Asia/Kolkata timezone\n  const kolkataDate = new Intl.DateTimeFormat(\"en-US\", {\n    timeZone: \"Asia/Kolkata\",\n    year: \"numeric\",\n    month: \"2-digit\",\n    day: \"2-digit\",\n  }).formatToParts(date);\n\n  // Extract values and format as MM/DD/YYYY\n  const month = kolkataDate.find((part) => part.type === \"month\").value;\n  const day = kolkataDate.find((part) => part.type === \"day\").value;\n  const year = kolkataDate.find((part) => part.type === \"year\").value;\n\n  return `${month}/${day}/${year}`;\n});\n\n\nreturn {\n  tooltip: {\n    trigger: \"axis\",\n    axisPointer: { type: \"cross\" },\n  },\n  legend: {\n    data: [\"FIQ PSA Inlet\", \"FIQ PSA Outlet\"],\n  },\n  grid: {\n    left: \"5%\",\n    right: \"4%\",\n    bottom: \"10%\",\n    containLabel: true,\n  },\n  xAxis: {\n    type: \"category\",\n    data: formattedDates,\n    axisLabel: {\n      formatter: function (val) {\n        const date = new Date(val);\n        const month = date.getMonth() + 1; // Month is zero-indexed\n        const day = date.getDate();\n        return `${month}/${day}`;\n      },\n    },\n  },\n  yAxis: {\n    type: \"value\",\n  },\n  series: [\n    {\n      name: \"FIQ PSA Inlet\",\n      type: \"bar\",\n      // stack: 'total',\n      data: inlet.map(value => (value == null || value <= 0 ? \"-\" : Math.round(value))),\n    },\n    {\n      name: \"FIQ PSA Outlet\",\n      type: \"bar\",\n      // stack: 'total',\n      data: outlet.map(value => (value == null || value <= 0 ? \"-\" : Math.round(value))),\n      // label: {\n      //   show: true,\n      //   position: \"top\",\n      //   formatter: function (params) {\n      //     return totalDailyFlow[params.dataIndex].toFixed(2); // Format to 2 decimal places\n      //   },\n      // },\n    },\n  ],\n};\n",
