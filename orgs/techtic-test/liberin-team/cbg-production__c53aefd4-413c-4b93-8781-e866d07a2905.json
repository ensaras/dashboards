          "plugin": "AMap.Scale,AMap.ToolBar"
        },
        "getOption": "let fit600_01 = [], fit600_02 = [], total = [];\n\ncontext.panel.data.series.forEach((s) => {\n  //if (s.refId === 'Daily Flow FIT 600-01') {\n  timeData = s.fields.find((f) => f.name === \"Time\")?.values ?? [];\n  fit600_01 =\n    s.fields.find((f) => f.name === \"Daily Flow FIT 600-01\")?.values ?? [];\n  //} else if (s.refId === 'Daily Flow FIT 600-02') {\n  fit600_02 =\n    s.fields.find((f) => f.name === \"Daily Flow FIT 600-02\")?.values ?? [];\n  //}\n  total = s.fields.find((f) => f.name === \"Total\")?.values ?? [];\n});\n\n// let totalDailyFlow = [];\n// for (let i = 0; i < timeData.length; i++) {\n//   let total = 0;\n//   total += fit600_01[i] || 0;\n//   total += fit600_02[i] || 0;\n//   totalDailyFlow.push(total);\n// }\n\n\n// Format dates for x-axis with Asia/Kolkata timezone\nconst formattedDates = timeData.map((d) => {\n  const date = new Date(d); // Parse the date string\n\n  // Convert to Asia/Kolkata timezone\n  const kolkataDate = new Intl.DateTimeFormat(\"en-US\", {\n    timeZone: \"Asia/Kolkata\",\n    year: \"numeric\",\n    month: \"2-digit\",\n    day: \"2-digit\",\n  }).formatToParts(date);\n\n  // Extract values and format as MM/DD/YYYY\n  const month = kolkataDate.find((part) => part.type === \"month\").value;\n  const day = kolkataDate.find((part) => part.type === \"day\").value;\n  const year = kolkataDate.find((part) => part.type === \"year\").value;\n\n  return `${month}/${day}/${year}`;\n});\n\n\nreturn {\n  tooltip: {\n    trigger: \"axis\",\n    axisPointer: { type: \"cross\" },\n    formatter: function (params) {\n      let tooltipText = `${params[0].axisValueLabel}<br />`;\n      params.forEach((item) => {\n        let value = item.data === '-' ? '-' : `${item.data} kg`;\n        tooltipText += `${item.marker} ${item.seriesName}: ${value} <br/>`;\n      });\n      return tooltipText;\n    },\n  },\n  legend: {\n    data: [\"FIT 600-01\", \"FIT 600-02\"],\n  },\n  grid: {\n    left: \"5%\",\n    right: \"4%\",\n    bottom: \"10%\",\n    containLabel: true,\n  },\n  xAxis: {\n    type: \"category\",\n    data: formattedDates,\n    axisLabel: {\n      formatter: function (val) {\n        const date = new Date(val);\n        const month = date.getMonth() + 1; // Month is zero-indexed\n        const day = date.getDate();\n        return `${month}/${day}`;\n      },\n    },\n  },\n  yAxis: {\n    type: \"value\",\n    axisLabel: {\n      formatter: function (val) {\n        return `${val} kg`;\n      }\n    }\n  },\n  series: [\n    {\n      name: \"FIT 600-01\",\n      type: \"bar\",\n      stack: 'total',\n      data: fit600_01.map(value => (value == null || value <= 0 ? \"-\" : Math.round(value))),\n    },\n    {\n      name: \"FIT 600-02\",\n      type: \"bar\",\n      stack: 'total',\n      data: fit600_02.map(value => (value == null || value <= 0 ? \"-\" : Math.round(value))),\n      label: {\n        show: true,\n        position: \"top\",\n        formatter: function (params) {\n          return Math.round(total[params.dataIndex]);\n        },\n      },\n    },\n  ],\n};\n",
        "google": {
          "callback": "gmapReady",
          "key": ""
        },
        "map": "none",
        "renderer": "canvas",
        "themeEditor": {
          "config": "{}",
          "height": 400,
