        },
        "getOption": "const series = context.panel.data.series.map((s) => {\n  const test = s.fields.find((f) => f.type === 'boolean').values.buffer\n    || s.fields.find((f) => f.type === 'boolean').values;\n  const sTime = s.fields.find((f) => f.type === 'time').values.buffer\n    || s.fields.find((f) => f.type === 'time').values;\n\n  const entries = sTime.map((time, index) => { return { data: test[index], time: time } })\n\n  // group by date and sum up the minutes\n  const openMinutes = {};\n  entries.forEach(entry => {\n    const date = new Date(entry.time);\n    const day = new Date(date.getFullYear(), date.getMonth(), date.getDate()).toLocaleDateString();\n\n    if (!openMinutes[day]) {\n      openMinutes[day] = 0;\n    }\n\n    if (entry.data) {\n      openMinutes[day] += 1;\n    }\n  });\n\n  // seperate the fields and use hour instead of minutes\n  const sDate = []\n  const sData = []\n  for (const key in openMinutes) {\n    if (openMinutes.hasOwnProperty(key)) {\n      sDate.push(key)\n      sData.push(openMinutes[key] / 60)\n    }\n  }\n\n  return { sDate, sData }\n});\n\nconsole.log(context.panel.data.series[0].fields)\n\nconsole.log(series)\n\nreturn {\n  tooltip: {},\n  grid: {\n    bottom: \"3%\",\n    containLabel: true,\n    left: \"3%\",\n    right: \"4%\",\n    top: \"4%\"\n  },\n  xAxis: {\n    type: 'category',\n    data: series[0].sDate\n  },\n  yAxis: {\n    type: 'value'\n  },\n  series: [\n    {\n      data: series[0].sData,\n      type: 'bar',\n    }\n  ]\n};",
