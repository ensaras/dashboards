      "id": 9,
      "options": {
        "baidu": {
          "callback": "bmapReady",
          "key": ""
        },
        "editor": {
          "format": "auto",
          "height": 600
        },
        "editorMode": "code",
        "gaode": {
          "key": "",
          "plugin": "AMap.Scale,AMap.ToolBar"
        },
        "getOption": "// 1. Extract and format the series safely\nconst chartSeries = context.panel.data.series.map((s) => {\n  const timeField = s.fields.find((f) => f.type === 'time');\n  const valueField = s.fields.find((f) => f.type === 'number');\n\n  // Safety check: if no data or field is missing, return null\n  if (!timeField || !valueField) return null;\n\n  return {\n    name: s.name || valueField.name || \"Hours\",\n    times: timeField.values.buffer || timeField.values,\n    values: valueField.values.buffer || valueField.values,\n  };\n}).filter(s => s !== null); // Remove any empty/broken series\n\n// 2. Handle the case where no data is returned at all\nif (chartSeries.length === 0) {\n  return { title: { text: 'No data found for selected range', left: 'center', top: 'center' } };\n}\n\n// 3. Prepare X-Axis (using the first series as the time template)\nconst xAxisData = chartSeries[0].times.map(t => {\n  const date = new Date(t);\n  // Format as MM/DD or HH:mm depending on density\n  return `${date.getMonth() + 1}/${date.getDate()}`;\n});\n\nreturn {\n  tooltip: {\n    trigger: 'axis',\n    axisPointer: { type: 'shadow' },\n    formatter: (params) => {\n      let res = `${params[0].name}<br/>`;\n      params.forEach(p => {\n        res += `${p.marker} ${p.seriesName}: <b>${p.value} h</b><br/>`;\n      });\n      return res;\n    }\n  },\n  legend: { top: '0%' },\n  grid: { bottom: \"10%\", containLabel: true, left: \"3%\", right: \"4%\", top: \"15%\" },\n  xAxis: {\n    type: 'category',\n    data: xAxisData,\n  },\n  yAxis: {\n    type: 'value',\n    name: 'Hours',\n    axisLabel: { formatter: '{value}' }\n  },\n  series: chartSeries.map(s => ({\n    name: s.name,\n    type: 'bar',\n    stack: 'total',\n    emphasis: { focus: 'series' },\n    data: s.values.map(v => v ? Number(v.toFixed(2)) : 0)\n  }))\n};",
        "google": {
          "callback": "gmapReady",
          "key": ""
        },
        "map": "none",
        "renderer": "canvas",
        "themeEditor": {
          "config": "{}",
          "height": 400,
          "name": "default"
        },
        "visualEditor": {
          "code": "return {\n  dataset: context.editor.dataset,\n  series: context.editor.series,\n  xAxis: {\n    type: 'time',\n  },\n  yAxis: {\n    type: 'value',\n    min: 'dataMin',\n  },\n}\n",
          "dataset": [],
          "series": []
        }
      },
      "pluginVersion": "7.2.2",
      "targets": [
        {
          "alias": "Running Hours",
          "datasource": {
            "type": "influxdb",
            "uid": "fd3abc45-62e7-430f-86c9-b2b2d7522070"
          },
          "hide": false,
          "query": "SELECT count(\"data\") * ${__interval_ms} / 3600000 AS \"value\" \nFROM \"mqtt-jabalpur\" \nWHERE (\"name\" = '${SingleEquipment}' AND \"data\" > 0) AND $timeFilter \nGROUP BY time(1d) fill(0)",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        },
