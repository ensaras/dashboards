      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cd00a2da-df1a-49f5-844c-61f5380ab50b"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH d AS (SELECT \"Date\", daily_rawbiogas AS g, COALESCE(daily_pressmud,0) AS p, COALESCE(daily_cowmanure,0) AS c FROM circlecbg_meerutplant_stats WHERE \"Date\" >= current_date - 60),\nv AS (SELECT \"Date\", CASE WHEN g IS NOT NULL AND p + c > 0 THEN g END AS g, CASE WHEN g IS NOT NULL AND p + c > 0 THEN p END AS p, CASE WHEN g IS NOT NULL AND p + c > 0 THEN c END AS c, CASE WHEN g IS NOT NULL AND p + c > 0 THEN 1 ELSE 0 END AS ok FROM d),\nr AS (SELECT \"Date\", SUM(g) OVER w AS g30, SUM(p) OVER w AS p30, SUM(c) OVER w AS c30, SUM(ok) OVER w AS n FROM v WINDOW w AS (ORDER BY \"Date\" RANGE BETWEEN INTERVAL '29 days' PRECEDING AND CURRENT ROW))\nSELECT (\"Date\"::timestamp AT TIME ZONE 'Asia/Kolkata') AS time, CASE WHEN n >= 20 THEN g30 / (p30 + c30) END AS \"Actual\", CASE WHEN n >= 20 THEN (100 * p30 + 40 * c30) / (p30 + c30) END AS \"Target\", CASE WHEN n >= 20 THEN 100 * g30 / (100 * p30 + 40 * c30) END AS \"% of target\", n AS \"Days with data\"\nFROM r WHERE \"Date\" BETWEEN ((now() AT TIME ZONE 'Asia/Kolkata')::date - 30) AND ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Raw gas yield · 30-day rolling",
      "type": "stat"
    },
