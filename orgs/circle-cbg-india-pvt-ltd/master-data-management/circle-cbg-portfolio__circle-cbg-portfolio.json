        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cd00a2da-df1a-49f5-844c-61f5380ab50b"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (SELECT daily_cbgfilled FROM circlecbg_meerutplant_stats WHERE \"Date\" = (SELECT max(\"Date\") FROM circlecbg_meerutplant_stats WHERE \"Date\" <= ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND daily_cbgfilled IS NOT NULL)) AS \"Latest day\", (SELECT 100 * daily_cbgfilled / 14600 FROM circlecbg_meerutplant_stats WHERE \"Date\" = (SELECT max(\"Date\") FROM circlecbg_meerutplant_stats WHERE \"Date\" <= ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND daily_cbgfilled IS NOT NULL)) AS \"% of design\", (SELECT avg(daily_cbgfilled) FROM circlecbg_meerutplant_stats WHERE \"Date\" BETWEEN ((now() AT TIME ZONE 'Asia/Kolkata')::date - 30) AND ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND daily_cbgfilled >= 730) AS \"⌀ 30 days\"",
          "refId": "A"
        }
      ],
      "title": "CBG filled · latest day",
      "type": "stat"
    },
    {
      "datasource": {
