          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH e AS (SELECT \"Date\", daily_power / NULLIF(daily_cbgfilled, 0) AS se FROM circlecbg_meerutplant_stats WHERE \"Date\" BETWEEN ((now() AT TIME ZONE 'Asia/Kolkata')::date - 30) AND ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND daily_cbgfilled >= 730 AND daily_power > 0), m AS (SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY se) AS med FROM e) SELECT (SELECT se FROM e WHERE \"Date\" = (SELECT max(\"Date\") FROM circlecbg_meerutplant_stats WHERE \"Date\" <= ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND daily_cbgfilled IS NOT NULL) AND se <= 2 * (SELECT med FROM m)) AS \"Latest day\", (SELECT avg(se) FROM e WHERE se <= 2 * (SELECT med FROM m)) AS \"⌀ 30 days\"",
          "refId": "A"
        }
      ],
      "title": "Specific energy · latest day",
      "type": "stat"
