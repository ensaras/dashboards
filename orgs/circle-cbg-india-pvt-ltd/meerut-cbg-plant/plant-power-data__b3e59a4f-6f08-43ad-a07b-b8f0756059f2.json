    {
      "datasource": {
        "type": "influxdb",
        "uid": "feb32dec-7015-4a8b-86fb-d02b000c8d7d"
      },
      "description": "Daily energy (kWh, midnight to midnight IST) from the PMCC and MCC4 energy-meter totalizers: each day = last reading minus the previous day's last reading. Days with no data are estimated by linear interpolation of the totalizer. Today's bar is partial.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 10,
      "options": {
        "baidu": {
          "callback": "bmapReady",
          "key": ""
        },
        "editor": {
          "format": "auto",
          "height": 600
        },
        "editorMode": "code",
        "gaode": {
          "key": "",
          "plugin": "AMap.Scale,AMap.ToolBar"
        },
        "getOption": "if (!context.panel.data?.series?.length) {\n  return {\n    xAxis: { type: \"category\", data: [] },\n    yAxis: { type: \"value\" },\n    series: [],\n  };\n}\n\nconst toArray = (v) =>\n  Array.isArray(v)\n    ? v\n    : v?.toArray\n      ? v.toArray()\n      : Array.from(v ?? []);\n\nconst getSeriesData = (seriesName) => {\n  const series = context.panel.data.series.find((s) =>\n    s.fields.some(\n      (f) =>\n        f.name === seriesName ||\n        f.config?.displayNameFromDS === seriesName ||\n        f.config?.displayName === seriesName\n    )\n  );\n\n  if (!series) {\n    return { time: [], values: [] };\n  }\n\n  const timeField = series.fields.find(\n    (f) => f.type === \"time\" || f.name === \"Time\"\n  );\n\n  const valueField = series.fields.find(\n    (f) =>\n      f.name === seriesName ||\n      f.config?.displayNameFromDS === seriesName ||\n      f.config?.displayName === seriesName\n  );\n\n  return {\n    time: toArray(timeField?.values),\n    values: toArray(valueField?.values),\n  };\n};\n\nconst totalPower = getSeriesData(\"Total Daily Power Consumption\");\nconst mcc4Power = getSeriesData(\"MCC4 Daily Power Consumption\");\n\nconst timeData = totalPower.time.length\n  ? totalPower.time\n  : mcc4Power.time;\n\nconst formattedDates = timeData.map((t) => {\n  const d = new Date(t + 19800000); // label in IST regardless of viewer time zone\n\n  return `${String(d.getUTCMonth() + 1).padStart(2, \"0\")}/${String(\n    d.getUTCDate()\n  ).padStart(2, \"0\")}`;\n});\n\nreturn {\n  tooltip: {\n    trigger: \"axis\",\n    axisPointer: {\n      type: \"cross\",\n    },\n    formatter: function (params) {\n      let text = `${params[0].axisValue}<br/>`;\n\n      params.forEach((item) => {\n        text += `${item.marker} ${item.seriesName}: ${Math.round(\n          item.value || 0\n        )} kWh<br/>`;\n      });\n\n      return text;\n    },\n  },\n\n  legend: {\n    data: [\n      \"Total Daily Power Consumption\",\n      \"MCC4 Daily Power Consumption\",\n    ],\n  },\n\n  grid: {\n    left: \"5%\",\n    right: \"4%\",\n    bottom: \"10%\",\n    containLabel: true,\n  },\n\n  xAxis: {\n    type: \"category\",\n    data: formattedDates,\n  },\n\n  yAxis: {\n    type: \"value\",\n    name: \"kWh\",\n    axisLabel: {\n      formatter: \"{value}\",\n    },\n  },\n\n  series: [\n    {\n      name: \"Total Daily Power Consumption\",\n      type: \"bar\",\n      data: totalPower.values.map((v) =>\n        v == null ? null : Math.round(v)\n      ),\n    },\n    {\n      name: \"MCC4 Daily Power Consumption\",\n      type: \"bar\",\n      data: mcc4Power.values.map((v) =>\n        v == null ? null : Math.round(v)\n      ),\n    },\n  ],\n};",
        "google": {
          "callback": "gmapReady",
          "key": ""
        },
        "map": "none",
        "renderer": "canvas",
        "themeEditor": {
          "config": "{}",
          "height": 400,
          "name": "default"
        },
        "visualEditor": {
          "code": "return {\n  dataset: context.editor.dataset,\n  series: context.editor.series,\n  xAxis: {\n    type: 'time',\n  },\n  yAxis: {\n    type: 'value',\n    min: 'dataMin',\n  },\n}\n",
          "dataset": [],
          "series": []
        }
      },
      "pluginVersion": "7.2.2",
      "targets": [
        {
          "alias": "Total Daily Power Consumption",
          "datasource": {
            "type": "influxdb",
            "uid": "feb32dec-7015-4a8b-86fb-d02b000c8d7d"
          },
          "hide": false,
          "query": "SELECT non_negative_difference(\"e\") AS \"Total Daily Power Consumption\" FROM (SELECT last(\"PMCC Panel Total Power In kWh\") AS \"e\" FROM \"mqtt\" WHERE time >= ${__from}ms - 1d AND time <= ${__to}ms GROUP BY time(1d,18h30m) fill(linear)) WHERE time >= ${__from}ms - 1d",
          "rawQuery": true,
          "refId": "B",
          "resultFormat": "time_series"
        },
        {
          "alias": "MCC4 Daily Power Consumption",
          "datasource": {
            "type": "influxdb",
            "uid": "feb32dec-7015-4a8b-86fb-d02b000c8d7d"
          },
          "hide": false,
          "query": "SELECT non_negative_difference(\"e\") AS \"MCC4 Daily Power Consumption\" FROM (SELECT last(\"MCC Panel Total Power In kWh\") AS \"e\" FROM \"mqtt\" WHERE time >= ${__from}ms - 1d AND time <= ${__to}ms GROUP BY time(1d,18h30m) fill(linear)) WHERE time >= ${__from}ms - 1d",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        }
      ],
      "title": "Total Daily Power Consumption",
      "type": "volkovlabs-echarts-panel"
