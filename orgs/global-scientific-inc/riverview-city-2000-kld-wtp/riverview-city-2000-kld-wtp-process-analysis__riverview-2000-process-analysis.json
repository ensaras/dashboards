      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf69552b-a590-45d1-ae8d-05eff2266e10"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH s AS (SELECT l.time_of_sample_collection AS time, CASE WHEN lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('Raw Water') AND btrim(l.type_of_lab_test) = 'TDS' THEN 'Raw' WHEN lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('Treated Water') AND btrim(l.type_of_lab_test) = 'TDS' THEN 'Treated' END AS metric, l.result::numeric AS value FROM user_labtestdata l JOIN user_customform f ON f.id = l.form_id WHERE f.team_id = 189 AND ((lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('Raw Water') AND btrim(l.type_of_lab_test) = 'TDS') OR (lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('Treated Water') AND btrim(l.type_of_lab_test) = 'TDS')) AND $__timeFilter(l.time_of_sample_collection) AND l.time_of_sample_collection < now()) SELECT time, metric, value FROM s ORDER BY 1",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf69552b-a590-45d1-ae8d-05eff2266e10"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH s AS (SELECT l.time_of_sample_collection AS time, CASE WHEN lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('Raw Water') AND btrim(l.type_of_lab_test) = 'TDS' THEN 'Raw' WHEN lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('Treated Water') AND btrim(l.type_of_lab_test) = 'TDS' THEN 'Treated' END AS metric, l.result::numeric AS value FROM user_labtestdata l JOIN user_customform f ON f.id = l.form_id WHERE f.team_id = 189 AND ((lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('Raw Water') AND btrim(l.type_of_lab_test) = 'TDS') OR (lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('Treated Water') AND btrim(l.type_of_lab_test) = 'TDS')) AND $__timeFilter(l.time_of_sample_collection) AND l.time_of_sample_collection < now()), m AS (SELECT time, value, date_trunc('month', time AT TIME ZONE 'Asia/Kolkata') AS mo FROM s), a AS (SELECT mo, avg(value) AS av, count(*) AS n FROM m GROUP BY mo)\nSELECT time, \"Monthly average\" FROM (SELECT DISTINCT m.time, a.av AS \"Monthly average\" FROM m JOIN a ON a.mo = m.mo WHERE a.n >= 3 UNION ALL SELECT a.mo AT TIME ZONE 'Asia/Kolkata', NULL::numeric FROM a WHERE a.mo AT TIME ZONE 'Asia/Kolkata' > $__timeFrom()::timestamptz) x ORDER BY time",
          "refId": "B"
        }
      ],
      "title": "TDS (mg/L) · raw and treated",
      "transparent": true,
      "type": "timeseries"
    },
