          "rawSql": "WITH x AS (WITH lim(param, test, ord, unit, dec, warn, alarm, lo, hi, sev) AS (VALUES\n('Treated COD (analyser)','cod',1,'mg/L',1,NULL::numeric,NULL::numeric,NULL::numeric,NULL::numeric,'amber'),\n('Treated TSS (analyser)','tss',2,'mg/L',1,NULL::numeric,NULL::numeric,NULL::numeric,NULL::numeric,'amber'),\n('Aeration tanks DO (lab, average)','do',3,'mg/L',1,NULL::numeric,NULL::numeric,NULL::numeric,NULL::numeric,'amber'),\n('Aeration tanks SV30 (lab, average)','sv',4,'mL/L',0,NULL::numeric,NULL::numeric,NULL::numeric,NULL::numeric,'amber')),\nd AS (SELECT 'cod' AS test, \"Date\" AS day, daily_avg_outlet_cod AS v FROM gsi_nandedmbr_stats WHERE \"Date\" >= ($__timeFrom()::timestamptz AT TIME ZONE 'Asia/Kolkata')::date AND \"Date\" < (now() AT TIME ZONE 'Asia/Kolkata')::date\n UNION ALL SELECT 'tss', \"Date\", daily_avg_outlet_tss FROM gsi_nandedmbr_stats WHERE \"Date\" >= ($__timeFrom()::timestamptz AT TIME ZONE 'Asia/Kolkata')::date AND \"Date\" < (now() AT TIME ZONE 'Asia/Kolkata')::date\n UNION ALL SELECT CASE WHEN btrim(l.type_of_lab_test) = 'DO' THEN 'do' ELSE 'sv' END, (l.time_of_sample_collection AT TIME ZONE 'Asia/Kolkata')::date, avg(l.result) FROM user_labtestdata l JOIN user_customform f ON f.id = l.form_id WHERE f.team_id = 4 AND btrim(l.location) ILIKE 'Aeration Tank%' AND btrim(l.type_of_lab_test) IN ('DO','SV30') AND $__timeFilter(l.time_of_sample_collection) GROUP BY 1, 2)\nSELECT lim.param, lim.ord, lim.unit, lim.dec, lim.warn, lim.alarm, lim.lo, lim.hi, lim.sev, to_char(d.day,'YYYY-MM-DD') AS day, d.v FROM lim LEFT JOIN d ON d.test = lim.test ORDER BY lim.ord, d.day),\nv AS (SELECT param, ord, unit, dec, warn, alarm, lo, hi, sev, NULL::text AS limtxt, day, v, (v < 0 OR (param ~* '\\mph\\M' AND v > 14)) AS bad FROM x),\np AS (SELECT param, min(ord) AS ord, max(unit) AS unit, max(dec) AS dec, max(warn) AS warn, max(alarm) AS alarm, max(lo) AS lo, max(hi) AS hi, max(sev) AS sev, max(limtxt) AS limtxt,\n  avg(v) FILTER (WHERE NOT bad) AS av, min(v) FILTER (WHERE NOT bad) AS mn, max(v) FILTER (WHERE NOT bad) AS mx, count(v) FILTER (WHERE NOT bad) AS n, count(v) FILTER (WHERE bad) AS nbad,\n  (array_agg(v ORDER BY day DESC) FILTER (WHERE v IS NOT NULL))[1] AS latest FROM v GROUP BY param),\nq AS (SELECT p.*, (SELECT count(*) FROM v WHERE v.param = p.param AND NOT v.bad AND ((p.lo IS NOT NULL AND (v.v < p.lo OR (CASE WHEN p.sev LIKE '%excl' THEN v.v >= p.hi ELSE v.v > p.hi END))) OR (p.lo IS NULL AND p.warn IS NOT NULL AND v.v >= p.warn))) AS nout FROM p)\nSELECT param || CASE WHEN unit <> '' THEN ' (' || unit || ')' ELSE '' END || CASE WHEN nbad > 0 THEN ' · ' || nbad || ' impossible|purple' ELSE '' END AS \"Parameter\",\n CASE WHEN latest IS NULL THEN '—' ELSE round(latest::numeric, dec)::text ||\n  CASE WHEN latest < 0 OR (param ~* '\\mph\\M' AND latest > 14) THEN '|purple'\n       WHEN lo IS NOT NULL THEN CASE WHEN latest < lo OR (CASE WHEN sev LIKE '%excl' THEN latest >= hi ELSE latest > hi END) THEN '|' || CASE WHEN sev LIKE 'red%' THEN 'red' ELSE 'amber' END ELSE '|ok' END\n       WHEN alarm IS NOT NULL AND latest >= alarm THEN '|red' WHEN warn IS NOT NULL AND latest >= warn THEN '|amber' WHEN warn IS NOT NULL THEN '|ok' ELSE '' END END AS \"Latest\",\n COALESCE(round(av::numeric, dec)::text, '—') AS \"⌀ period\",\n COALESCE(round(mn::numeric, dec)::text || ' – ' || round(mx::numeric, dec)::text, '—') AS \"Range\",\n COALESCE(limtxt, CASE WHEN lo IS NOT NULL THEN lo::text || ' – ' || hi::text WHEN warn IS NOT NULL THEN '< ' || warn::text || CASE WHEN alarm IS NOT NULL AND alarm <> warn THEN ' · alarm ' || alarm::text ELSE '' END ELSE '—' END) AS \"Limit\",\n CASE WHEN (lo IS NULL AND warn IS NULL) OR n = 0 THEN '—' ELSE nout || ' of ' || n || CASE WHEN nout = 0 THEN '|ok' WHEN nout < n / 2.0 THEN '|amber' ELSE '|red' END END AS \"Days outside\"\nFROM q ORDER BY ord",
          "refId": "A"
        }
      ],
      "title": "Treated water and aeration · summary",
      "type": "table"
    },
