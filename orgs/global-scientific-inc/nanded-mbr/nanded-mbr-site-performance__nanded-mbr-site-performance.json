      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf69552b-a590-45d1-ae8d-05eff2266e10"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (SELECT daily_permeate_flow FROM gsi_nandedmbr_stats WHERE \"Date\" = (SELECT max(\"Date\") FROM gsi_nandedmbr_stats WHERE \"Date\" <= ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND daily_permeate_flow IS NOT NULL)) AS \"Latest day\", (SELECT 100 * daily_permeate_flow / 7500 FROM gsi_nandedmbr_stats WHERE \"Date\" = (SELECT max(\"Date\") FROM gsi_nandedmbr_stats WHERE \"Date\" <= ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND daily_permeate_flow IS NOT NULL)) AS \"% of design\", (SELECT avg(daily_permeate_flow) FROM gsi_nandedmbr_stats WHERE \"Date\" BETWEEN ((now() AT TIME ZONE 'Asia/Kolkata')::date - 30) AND ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1)) AS \"⌀ 30 days\"",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf69552b-a590-45d1-ae8d-05eff2266e10"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(max(\"Date\"), 'DD Mon') || CASE WHEN max(\"Date\") < ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) THEN '|old' ELSE '' END AS \"Day\" FROM gsi_nandedmbr_stats WHERE \"Date\" <= ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND \"Date\" > ((now() AT TIME ZONE 'Asia/Kolkata')::date - 60) AND daily_permeate_flow IS NOT NULL",
          "refId": "D"
        }
      ],
      "title": "Treated permeate · latest day",
      "type": "stat"
    },
