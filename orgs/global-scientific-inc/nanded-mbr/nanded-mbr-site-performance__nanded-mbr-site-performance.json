          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH w AS (SELECT min(daily_avg_outlet_cod) AS mn, max(daily_avg_outlet_cod) AS mx, count(daily_avg_outlet_cod) AS n, avg(daily_avg_outlet_cod) AS av FROM gsi_nandedmbr_stats WHERE \"Date\" BETWEEN ((now() AT TIME ZONE 'Asia/Kolkata')::date - 30) AND ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1)) SELECT (SELECT round(daily_avg_outlet_cod::numeric, 1) || ' mg/L' || CASE WHEN w.n >= 7 AND w.mn = w.mx THEN ' · constant 30 days' ELSE '' END FROM gsi_nandedmbr_stats WHERE \"Date\" = (SELECT max(\"Date\") FROM gsi_nandedmbr_stats WHERE \"Date\" <= ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND daily_avg_outlet_cod IS NOT NULL)) AS \"Latest day\", w.av AS \"⌀ 30 days\" FROM w",
