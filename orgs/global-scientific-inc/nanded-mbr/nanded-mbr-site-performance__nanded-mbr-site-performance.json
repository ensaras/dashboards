        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf69552b-a590-45d1-ae8d-05eff2266e10"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH e AS (SELECT \"Date\", daily_power / NULLIF(daily_permeate_flow, 0) AS se FROM gsi_nandedmbr_stats WHERE \"Date\" BETWEEN ((now() AT TIME ZONE 'Asia/Kolkata')::date - 30) AND ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND daily_power > 0 AND daily_permeate_flow > 0), m AS (SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY se) AS med FROM e) SELECT (SELECT se FROM e WHERE \"Date\" = (SELECT max(\"Date\") FROM gsi_nandedmbr_stats WHERE \"Date\" <= ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND daily_power IS NOT NULL) AND se <= 2 * (SELECT med FROM m)) AS \"Latest day\", (SELECT avg(se) FROM e WHERE se <= 2 * (SELECT med FROM m)) AS \"⌀ 30 days\"",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf69552b-a590-45d1-ae8d-05eff2266e10"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(max(\"Date\"), 'DD Mon') || CASE WHEN max(\"Date\") < ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) THEN '|old' ELSE '' END AS \"Day\" FROM gsi_nandedmbr_stats WHERE \"Date\" <= ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND \"Date\" > ((now() AT TIME ZONE 'Asia/Kolkata')::date - 60) AND daily_power IS NOT NULL",
          "refId": "D"
        }
      ],
      "title": "Specific energy · latest day",
      "type": "stat"
    },
