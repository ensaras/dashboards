          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH s AS (SELECT (\"Date\"::timestamp AT TIME ZONE 'Asia/Kolkata') AS time, 'Treated COD' AS metric, daily_avg_outlet_cod::numeric AS value FROM gsi_nandedmbr_stats WHERE \"Date\" >= ($__timeFrom()::timestamptz AT TIME ZONE 'Asia/Kolkata')::date AND \"Date\" < (now() AT TIME ZONE 'Asia/Kolkata')::date AND daily_avg_outlet_cod IS NOT NULL AND daily_avg_outlet_cod > 0) SELECT time, metric, value FROM s ORDER BY 1",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf69552b-a590-45d1-ae8d-05eff2266e10"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH s AS (SELECT (\"Date\"::timestamp AT TIME ZONE 'Asia/Kolkata') AS time, 'Treated COD' AS metric, daily_avg_outlet_cod::numeric AS value FROM gsi_nandedmbr_stats WHERE \"Date\" >= ($__timeFrom()::timestamptz AT TIME ZONE 'Asia/Kolkata')::date AND \"Date\" < (now() AT TIME ZONE 'Asia/Kolkata')::date AND daily_avg_outlet_cod IS NOT NULL AND daily_avg_outlet_cod > 0), m AS (SELECT time, value, date_trunc('month', time AT TIME ZONE 'Asia/Kolkata') AS mo FROM s), a AS (SELECT mo, avg(value) AS av, count(*) AS n FROM m GROUP BY mo)\nSELECT time, \"Monthly average\" FROM (SELECT DISTINCT m.time, a.av AS \"Monthly average\" FROM m JOIN a ON a.mo = m.mo WHERE a.n >= 3 UNION ALL SELECT a.mo AT TIME ZONE 'Asia/Kolkata', NULL::numeric FROM a WHERE a.mo AT TIME ZONE 'Asia/Kolkata' > $__timeFrom()::timestamptz) x ORDER BY time",
          "refId": "B"
        }
      ],
      "title": "Treated COD (mg/L)",
      "transparent": true,
      "type": "timeseries"
    },
