          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH s AS (SELECT l.time_of_sample_collection AS time, CASE WHEN lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('Aeration Tank 1') AND btrim(l.type_of_lab_test) = 'DO' THEN 'Aeration 1' WHEN lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('Aeration Tank 2') AND btrim(l.type_of_lab_test) = 'DO' THEN 'Aeration 2' WHEN lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('MBR Tank 1') AND btrim(l.type_of_lab_test) = 'DO' THEN 'MBR 1' WHEN lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('MBR Tank 2') AND btrim(l.type_of_lab_test) = 'DO' THEN 'MBR 2' END AS metric, l.result::numeric AS value FROM user_labtestdata l JOIN user_customform f ON f.id = l.form_id WHERE f.team_id = 4 AND ((lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('Aeration Tank 1') AND btrim(l.type_of_lab_test) = 'DO') OR (lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('Aeration Tank 2') AND btrim(l.type_of_lab_test) = 'DO') OR (lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('MBR Tank 1') AND btrim(l.type_of_lab_test) = 'DO') OR (lower(regexp_replace(btrim(l.location), '\\s*:.*$', '')) = lower('MBR Tank 2') AND btrim(l.type_of_lab_test) = 'DO')) AND $__timeFilter(l.time_of_sample_collection) AND l.time_of_sample_collection < now()) SELECT time, metric, value FROM s ORDER BY 1",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf69552b-a590-45d1-ae8d-05eff2266e10"
