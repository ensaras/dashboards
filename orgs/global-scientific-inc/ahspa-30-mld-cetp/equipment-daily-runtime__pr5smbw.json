      "targets": [
        {
          "dataset": "usermgmt",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf69552b-a590-45d1-ae8d-05eff2266e10"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH date_series AS (\r\n    SELECT generate_series(\r\n        $__timeFrom()::timestamptz AT TIME ZONE 'Asia/Kolkata',  \r\n        $__timeTo()::timestamptz AT TIME ZONE 'Asia/Kolkata',    \r\n        '1 day'::interval\r\n    )::date AS date\r\n),\r\ndaily_readings AS (\r\n    SELECT\r\n        (d.datetime AT TIME ZONE 'Asia/Kolkata')::date AS date,\r\n        d.form_id,\r\n        CASE\r\n            WHEN d.is_override THEN d.reset_value\r\n            ELSE d.daily_runtime\r\n        END AS runtime\r\n    FROM user_equipmentruntimemeterreadingdata d\r\n    WHERE\r\n        d.form_id IN (684, 686, 687, 688, 689)\r\n        AND $__timeFilter(d.datetime)\r\n)\r\nSELECT\r\n    ds.date::timestamp AS \"time\",\r\n    MAX(CASE WHEN dr.form_id = 684 THEN dr.runtime END) AS \"EPS Pump 1\",\r\n    MAX(CASE WHEN dr.form_id = 686 THEN dr.runtime END) AS \"EPS Pump 2\",\r\n    MAX(CASE WHEN dr.form_id = 687 THEN dr.runtime END) AS \"EPS Pump 3\",\r\n    MAX(CASE WHEN dr.form_id = 688 THEN dr.runtime END) AS \"EPS Pump 4\",\r\n    MAX(CASE WHEN dr.form_id = 689 THEN dr.runtime END) AS \"EPS Pump 5\"\r\nFROM date_series ds\r\nLEFT JOIN daily_readings dr ON ds.date = dr.date\r\nWHERE\r\n    ds.date >= (CAST($__timeFrom() AS timestamptz) AT TIME ZONE 'Asia/Kolkata')::date\r\n    AND ds.date <= (CAST($__timeTo() AS timestamptz) AT TIME ZONE 'Asia/Kolkata')::date\r\nGROUP BY ds.date\r\nORDER BY ds.date ASC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "EPS Pumps Daily Runtime",
      "type": "barchart"
    },
