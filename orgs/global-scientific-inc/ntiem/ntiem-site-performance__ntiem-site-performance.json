        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf69552b-a590-45d1-ae8d-05eff2266e10"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (SELECT daily_flow_out FROM gsi_ntiem_stats WHERE \"Date\" = (SELECT max(\"Date\") FROM gsi_ntiem_stats WHERE \"Date\" <= ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND daily_flow_out IS NOT NULL)) AS \"Latest day\", (SELECT 100 * daily_flow_out / 100000 FROM gsi_ntiem_stats WHERE \"Date\" = (SELECT max(\"Date\") FROM gsi_ntiem_stats WHERE \"Date\" <= ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND daily_flow_out IS NOT NULL)) AS \"% of design\", (SELECT avg(daily_flow_out) FROM gsi_ntiem_stats WHERE \"Date\" BETWEEN ((now() AT TIME ZONE 'Asia/Kolkata')::date - 30) AND ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1)) AS \"⌀ 30 days\"",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf69552b-a590-45d1-ae8d-05eff2266e10"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(max(\"Date\"), 'DD Mon') || CASE WHEN max(\"Date\") < ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) THEN '|old' ELSE '' END AS \"Day\" FROM gsi_ntiem_stats WHERE \"Date\" <= ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) AND \"Date\" > ((now() AT TIME ZONE 'Asia/Kolkata')::date - 60) AND daily_flow_out IS NOT NULL",
          "refId": "D"
        }
      ],
      "title": "Treated outflow · latest day",
      "type": "stat"
    },
