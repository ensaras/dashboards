          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n    time_of_sample_collection AS \"time\",\r\n    result AS \"value\",\r\n    CONCAT(btrim(location), ' - ', btrim(type_of_lab_test)) AS \"metric\"\r\nFROM user_labtestdata\r\nWHERE\r\n    form_id = 708\r\n    AND btrim(location) IN ('${LabTestLocation:raw}')\r\n    AND btrim(type_of_lab_test) IN ('${LabTestType:raw}')\r\n    AND $__timeFilter(time_of_sample_collection)\r\nORDER BY time_of_sample_collection ASC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Lab Test [$LabTestLocation] - $LabTestType",
