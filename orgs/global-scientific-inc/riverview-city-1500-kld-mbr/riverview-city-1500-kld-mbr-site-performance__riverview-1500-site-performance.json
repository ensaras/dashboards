          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH d AS (SELECT (l.time_of_sample_collection AT TIME ZONE 'Asia/Kolkata')::date AS day, avg(l.result) AS v FROM user_labtestdata l JOIN user_customform f ON f.id = l.form_id WHERE f.team_id = 191 AND btrim(l.location) = 'Treated Wastewater' AND btrim(l.type_of_lab_test) = 'COD' AND l.time_of_sample_collection > now() - interval '31 days' AND l.time_of_sample_collection < now() GROUP BY 1) SELECT to_char(max(day), 'DD Mon') || CASE WHEN max(day) < ((now() AT TIME ZONE 'Asia/Kolkata')::date - 1) THEN '|old' ELSE '' END AS \"Day\" FROM d",
