          "rawQuery": true,
          "rawSql": "WITH x AS (WITH lim(param, test, ord, unit, dec, warn, alarm, lo, hi, sev) AS (VALUES\n('COD','COD',1,'mg/L',0,NULL::numeric,NULL::numeric,NULL::numeric,NULL::numeric,'amber'),\n('pH','pH',2,'',1,NULL::numeric,NULL::numeric,NULL::numeric,NULL::numeric,'amber'),\n('Turbidity','Turbidity',3,'NTU',1,NULL::numeric,NULL::numeric,NULL::numeric,NULL::numeric,'amber')),\nd AS (SELECT btrim(l.type_of_lab_test) AS test, (l.time_of_sample_collection AT TIME ZONE 'Asia/Kolkata')::date AS day, avg(l.result) AS v\n FROM user_labtestdata l JOIN user_customform f ON f.id = l.form_id\n WHERE f.team_id = 191 AND btrim(l.location) = 'Treated Wastewater' AND $__timeFilter(l.time_of_sample_collection) AND l.time_of_sample_collection < now() GROUP BY 1, 2)\nSELECT lim.param, lim.ord, lim.unit, lim.dec, lim.warn, lim.alarm, lim.lo, lim.hi, lim.sev, to_char(d.day,'YYYY-MM-DD') AS day, d.v\nFROM lim LEFT JOIN d ON d.test = lim.test ORDER BY lim.ord, d.day) SELECT (day::date)::timestamp AS time, param AS metric, v AS value FROM x WHERE day IS NOT NULL ORDER BY 1",
